# Copy to .env and edit. Everything works as-is in mock mode (no cloud accounts needed).
POSTGRES_PASSWORD=dashboard

# --- Provider modes: mock | live | disabled ---------------------------------
AWS_MODE=mock
AZURE_MODE=mock
GCP_MODE=mock

# --- Notifications (leave blank to only record alerts in the dashboard) -------
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WEBHOOK_TOKEN=
DASHBOARD_URL=http://localhost:8080

# --- AWS (MODE=live). Credentials via the standard AWS variables --------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGIONS=us-east-1
AWS_ENVIRONMENT_TAG=Environment

# --- Azure (MODE=live). Service principal ------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_ENVIRONMENT_TAG=Environment

# --- GCP (MODE=live). Spend is read from the Cloud Billing BigQuery export -----
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT_ID=
GCP_BILLING_EXPORT_TABLE=
GCP_ENVIRONMENT_LABEL=environment
GOOGLE_APPLICATION_CREDENTIALS=

# --- Tuning -------------------------------------------------------------------
COST_COLLECTION_INTERVAL_MINUTES=360
RESOURCE_COLLECTION_INTERVAL_MINUTES=15
